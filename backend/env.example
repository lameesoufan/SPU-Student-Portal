# ── SPU Student Portal - Environment Variables ──
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control!

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
STUDENT_VERIFY_URL=https://your-university-api.example.com/verify

DATABASE_ENGINE=postgresql
DB_NAME=spu_portal
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer
REQUIRE_POSTGRES=True

DRF_ANON_THROTTLE_RATE=60/minute
DRF_USER_THROTTLE_RATE=600/minute
DRF_PAGE_SIZE=50

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_PROTO=False

GITLAB_URL=http://localhost:8080
GITLAB_TOKEN=your-gitlab-token
GITLAB_WEBHOOK_SECRET=your-webhook-secret
GITLAB_WEBHOOK_BASE_URL=http://localhost:8000
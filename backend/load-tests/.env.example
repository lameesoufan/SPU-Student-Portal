# Target API.
LOAD_TEST_HOST=http://127.0.0.1:8000

# Student identity pool. The prepare script creates/updates these dedicated
# staging users automatically. No users.json and no manual 200-user setup.
LOAD_STUDENT_PREFIX=load_student_
LOAD_STUDENT_COUNT=220
LOAD_STUDENT_PASSWORD=LoadTest123!
LOAD_STUDENT_DEPARTMENT=software_engineering

# Existing dedicated accounts for the other roles. The prepare script validates
# them and generates JWTs locally; it does not create a second HoD.
LOAD_DOCTOR_USERNAME=load_doctor
LOAD_DOCTOR_PASSWORD=LoadTest123!

LOAD_HOD_USERNAME=amer
LOAD_HOD_PASSWORD=LoadTest123!

LOAD_DEAN_USERNAME=load_dean
LOAD_DEAN_PASSWORD=LoadTest123!

# Performance gate.
LOAD_MAX_FAILURE_RATIO=0.02
LOAD_MAX_P95_MS=800
LOAD_MAX_P99_MS=1500

# baseline | stress | spike | soak
LOAD_PROFILE=baseline

# Keep disabled unless write_load.py is intentionally used on disposable data.
ALLOW_WRITE_LOAD_TESTS=0

[run]
branch = True
parallel = False
source =
    accounts
    projects
    workflow
    project_management
    notifications
    grades
    committees
    project_imports
    gitlab_integration
    dy_forms
    backend
omit =
    */migrations/*
    */tests/*
    */admin.py
    */apps.py
    manage.py

[report]
show_missing = True
skip_covered = False
precision = 1
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    if __name__ == .__main__.:

[html]
directory = .test-artifacts/htmlcov

[xml]
output = .test-artifacts/coverage.xml

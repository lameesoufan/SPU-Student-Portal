    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "test:api": "vitest run src/__tests__/api.auth.test.js src/__tests__/api.contracts.test.js src/__tests__/api.payloads.test.js src/__tests__/gitlabApi.test.js src/lib/__tests__/constants.test.js src/lib/__tests__/utils.test.js",
    "test:role-ui": "vitest run --config vitest.ui.config.js src/components/__tests__/DashboardLayout.role-ui.test.jsx src/components/__tests__/Navbar.role-ui.test.jsx src/components/__tests__/NotificationBell.ui.test.jsx src/__tests__/App.role-ui.test.jsx"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
